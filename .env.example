# Copiar este archivo como .env y completar los valores vacíos.
# El .env no se sube al repo, porque tiene claves (RNF-06).

# Base de datos de M7
POSTGRES_DB=m7
POSTGRES_USER=m7
POSTGRES_PASSWORD=

# Clave del usuario admin de Keycloak (solo en local)
KEYCLOAK_ADMIN_PASSWORD=

# true saltea la validación del token: solo para desarrollar
AUTH_DISABLED=false

# Clave que manda la pasarela simulada en el encabezado X-Webhook-Secret
PASARELA_WEBHOOK_SECRET=

# Comisión de la plataforma en las liquidaciones (0.20 = 20%)
COMISION_PLATAFORMA=0.20

# Solo para correr la API sin Docker, con la base de Docker levantada.
# Cambiar <clave> por el mismo valor de POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://m7:<clave>@localhost:5432/m7
